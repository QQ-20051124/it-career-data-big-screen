# ============================================================
# 后端环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实API密钥
# 命令：cp backend/.env.example backend/.env
# ============================================================

# 服务端口
PORT=3001

# Coze API配置（主模型，用于 AI 答疑 + 资源生成二级兜底）
COZE_API_KEY=your_coze_api_key_here
COZE_BOT_ID=your_coze_bot_id_here
COZE_API_BASE=https://api.coze.cn
